# Supabase project (Project Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional. Web always uses window.location.origin, so Vercel does not need it.
# For native EAS builds, set it to the production web URL (e.g. https://app.needcart.app).
# Leave empty for local native dev builds to use Expo Linking.
EXPO_PUBLIC_APP_URL=
